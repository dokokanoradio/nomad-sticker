---
// props
interface Props {
  id: string; // ID
  rows?: number; // 行数(デフォルト5)
  placeholder?: string; // プレースホルダー(空の時に表示する:デフォルト空文字)
}
const { id, rows = 5, placeholder = "" } = Astro.props;
---

<textarea
  class="textarea textarea-primary w-full"
  id={id}
  rows={rows}
  placeholder={placeholder}
  readonly
></textarea>
