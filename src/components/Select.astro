---
import { MAX_NUM_STICKER } from "../lib/constants";

// props
interface Props {
  label: string; // ラベル
}
const { label } = Astro.props;

// 自動設定のパラメーター定義
const numOptions = MAX_NUM_STICKER + 1; // オプションの個数(0を含むので1個多い)
---

<div class="card bg-base-100 w-auto shadow-sm">
  <div class="card-body">
    <h2 class="card-title">{label}</h2>
    <p>枚数を入力</p>
    <div class="card-actions justify-end">
      <select class="select w-full">
        {[...Array(numOptions)].map((_, i) => (
          <option value={i}>{i}</option>
        ))}
      </select>
    </div>
  </div>
</div>
